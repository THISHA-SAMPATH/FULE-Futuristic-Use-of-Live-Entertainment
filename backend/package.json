{
  "name": "fule-protect-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "dev": "node --env-file=.env --watch server.js",
    "start": "node --env-file=.env server.js",
    "test": "node --test",
    "create:admin": "node --env-file=.env scripts/createAdmin.js",
    "migrate:latest": "node scripts/migrateLatest.js",
    "verify:infrastructure": "node scripts/verifyProductionInfrastructure.js",
    "migrate:sqlite": "node --env-file=.env scripts/migrateSqliteToPostgres.js",
    "lint": "node --check server.js && node --check services/incidentRepository.js && node --check services/incidentStore.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1162.0",
    "@socket.io/redis-adapter": "^8.3.0",
    "bcryptjs": "^3.0.3",
    "bullmq": "^6.6.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "helmet": "^8.3.0",
    "ioredis": "^6.0.0",
    "jsonwebtoken": "^9.0.3",
    "knex": "^3.3.0",
    "livekit-server-sdk": "^2.19.2",
    "pg": "^8.23.1",
    "prom-client": "^15.1.3",
    "socket.io": "^4.8.1",
    "web-push": "^3.6.7"
  }
}
