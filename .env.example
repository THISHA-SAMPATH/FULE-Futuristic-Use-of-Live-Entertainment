# Local self-hosted FULE stack. Copy to .env for docker compose.
DEMO_MODE=true
FRONTEND_ORIGIN=http://localhost:4173
POSTGRES_PASSWORD=change-this-local-password
JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
METRICS_TOKEN=replace-with-a-long-random-token
SAFE_WALK_PIN_PEPPER=replace-with-a-random-secret-of-at-least-32-characters
EVIDENCE_ENCRYPTION_KEY=

# Web Push keys (generate with: npx web-push generate-vapid-keys)
WEB_PUSH_PUBLIC_KEY=
WEB_PUSH_PRIVATE_KEY=
WEB_PUSH_SUBJECT=mailto:security@fule.local

# Local object storage
MINIO_ROOT_USER=fule-local
MINIO_ROOT_PASSWORD=change-this-minio-password
AWS_ACCESS_KEY_ID=fule-local
AWS_SECRET_ACCESS_KEY=change-this-minio-password
AWS_REGION=us-east-1
AWS_S3_ENDPOINT=http://minio:9000
AWS_S3_FORCE_PATH_STYLE=true
LIVEKIT_EGRESS_S3_BUCKET=fule-evidence
LIVEKIT_EGRESS_PREFIX=fule-evidence
LIVEKIT_RECORDING_RETENTION_DAYS=30

# Local media stack. Replace before exposing the stack beyond localhost.
LIVEKIT_API_KEY=fule-local-key
LIVEKIT_API_SECRET=replace-with-a-long-random-livekit-secret
LIVEKIT_PUBLIC_URL=ws://localhost:7880
LIVEKIT_TOKEN_TTL_SECONDS=180
LIVEKIT_MAX_PARTICIPANTS=12
LIVEKIT_TURN_URL=turn:localhost:3478?transport=udp
TURN_USERNAME=fule-local
TURN_PASSWORD=replace-with-a-long-random-turn-password
TURN_SHARED_SECRET=replace-with-a-long-random-turn-secret
TURN_EXTERNAL_IP=127.0.0.1

INCIDENT_RETENTION_DAYS=90
NEARBY_GUARDIAN_RADIUS_METERS=400
FULE_LOAD_TEST_TOKEN=
