# Copy to backend/.env. Keep real credentials server side.
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
TWITCH_BOT_TOKEN=
TWITCH_REDIRECT_URI=http://localhost:4000/auth/twitch/callback
TWITCH_SILENT_SOS_REWARD_ID=
TWITCH_SILENT_SOS_COST=1
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# Real emergency integration: keep blank in demo. Non-demo mode fails closed if it is unconfigured.
DISPATCH_WEBHOOK_URL=
DISPATCH_WEBHOOK_SECRET=
DISPATCH_WEBHOOK_RETRIES=2
# Twilio trusted-contact notifications. Mocked while DEMO_MODE=true.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
# Demo only. Set false in any public/deployed environment.
DEMO_MODE=true
FRONTEND_ORIGIN=http://localhost:5173
PORT=4000
TRUST_PROXY_HOPS=0
# Production persistence and shared coordination.
DATABASE_URL=
REDIS_URL=
PG_POOL_MAX=20
PGSSLMODE=
PGSSL_REJECT_UNAUTHORIZED=true
JWT_ACCESS_SECRET=replace-with-a-random-secret-of-at-least-32-characters
TWITCH_TOKEN_ENCRYPTION_KEY=base64-encode-exactly-32-random-bytes
INCIDENT_RETENTION_DAYS=90
SOCKET_CONNECT_RATE_LIMIT=2000
SOCKETS_PER_IP_LIMIT=2000
# Optional observability. Protect the metrics endpoint with a bearer token in production.
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0
METRICS_TOKEN=replace-with-a-long-random-token
# Demo only. Replace locally and never reuse for a real guardian invite.
FULE_DEMO_GUARDIAN_INVITE=demo-guardian-invite
FULE_DATA_DIR=./data
POSTGRES_PASSWORD=local-compose-demo-password
# Optional ladder timing overrides (milliseconds); production defaults are 30s and 60s.
FULE_CONTACTS_DELAY_MS=
FULE_DISPATCH_DELAY_MS=
SAFE_WALK_PIN_PEPPER=replace-with-a-random-secret-of-at-least-32-characters
WEB_PUSH_PUBLIC_KEY=
WEB_PUSH_PRIVATE_KEY=
WEB_PUSH_SUBJECT=mailto:security@fule.app
NEARBY_GUARDIAN_RADIUS_METERS=400
NEARBY_GUARDIAN_OFFER_LIMIT=10
NEARBY_GUARDIAN_ACCEPT_CAP=5
EVIDENCE_STORAGE_DIR=./data/evidence
EVIDENCE_ENCRYPTION_KEY=
# Demo-only load-test authorization. Leave blank outside local load testing.
FULE_LOAD_TEST_TOKEN=
FULE_SOS_IP_LIMIT=6
FULE_API_IP_LIMIT=180
